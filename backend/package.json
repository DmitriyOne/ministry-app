{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > ../web/src/shared/api/supabase/database.types.ts",
    "db:login": "supabase login",
    "db:link": "sh -c 'supabase link --project-ref \"${SUPABASE_PROJECT_REF:?Set SUPABASE_PROJECT_REF, e.g. SUPABASE_PROJECT_REF=abcxyz pnpm db:link}\"'",
    "db:push": "supabase db push",
    "functions:deploy": "supabase functions deploy",
    "push:launch": "node scripts/send-waitlist-launch-push.mjs",
    "push:version": "node scripts/send-version-push.mjs"
  },
  "devDependencies": {
    "supabase": "2.122.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "web-push": "^3.6.7"
  }
}
