{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > ../web/src/shared/api/supabase/database.types.ts",
    "db:login": "supabase login",
    "db:link": "sh -c 'supabase link --project-ref \"${SUPABASE_PROJECT_REF:?Set SUPABASE_PROJECT_REF, e.g. SUPABASE_PROJECT_REF=abcxyz pnpm db:link}\"'",
    "db:push": "supabase db push",
    "functions:deploy": "supabase functions deploy"
  },
  "devDependencies": {
    "supabase": "2.117.0"
  }
}
