# Copy this file to envs/backend.local.env and fill in real local values.
# envs/backend.local.env is gitignored — never commit real values.
#
# Ports below match backend/supabase/config.toml defaults produced by `supabase init`.

# URL polled by `pnpm dev` / `pnpm wait:supabase` before starting the Next.js dev server.
# GoTrue's health endpoint responds 200 as soon as the local stack is ready.
SUPABASE_HEALTH_URL=http-get://127.0.0.1:54321/auth/v1/health

SUPABASE_API_PORT=54321
SUPABASE_DB_PORT=54322
SUPABASE_STUDIO_PORT=54323

# Admin-only backend access used by the manual launch-push sender.
# Local values are printed by `supabase status`; hosted secret keys are in
# Supabase Dashboard -> Connect / Settings -> API Keys. Never expose the secret.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=replace-with-local-or-hosted-sb_secret-key

# Use the SAME VAPID pair as the web sender for this environment.
WEB_PUSH_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
WEB_PUSH_VAPID_PRIVATE_KEY=replace-with-vapid-private-key
WEB_PUSH_VAPID_SUBJECT=mailto:you@example.com
