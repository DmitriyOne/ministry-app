# Copy this file to envs/web.local.env and fill in real local values.
# envs/web.local.env is gitignored — never commit real values.
#
# These are the default values produced by `supabase start` for a freshly
# initialized local project (see `supabase status` after starting).

# Public — safe to expose to the browser (NEXT_PUBLIC_* is inlined at build time).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The publishable key (`sb_publishable_...`) — Supabase's replacement for
# the legacy `anon` key. Take it from `supabase status` -> PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key-from-supabase-status

# Next.js dev server port (used by `pnpm dev`).
PORT=3000

# Development only — never set in production (Vercel). true disables the
# "phone only" shield (ADR 0015) so the app opens on desktop/tablets too.
# Unset or false — the default — keeps the shield active.
DEV_MODE=false

# Development only. Your machine's LAN IP(s), so the Next.js dev server
# accepts requests opened from a phone on the same Wi-Fi (e.g. to test on
# a real iPhone). Unset — the default — adds no extra allowed origin.
# Comma-separated when you move between networks (e.g. home Wi-Fi and a
# mobile hotspot) — whitespace around each entry is trimmed, empty
# entries are dropped. Find your address with `ipconfig getifaddr en0`
# (macOS Wi-Fi) or `hostname -I` (Linux); it changes whenever you change
# networks.
DEV_ALLOWED_ORIGIN=192.168.1.x,192.168.2.x
