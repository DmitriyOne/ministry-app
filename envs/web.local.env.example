# Copy this file to envs/web.local.env and fill in real local values.
# envs/web.local.env is gitignored — never commit real values.
#
# These are the default values produced by `supabase start` for a freshly
# initialized local project (see `supabase status` after starting).

# Public — safe to expose to the browser (NEXT_PUBLIC_* is inlined at build time).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The publishable key (`sb_publishable_...`) — Supabase's replacement for
# the legacy `anon` key. Take it from `supabase status` -> PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key-from-supabase-status

# Next.js dev server port (used by `pnpm dev`).
PORT=3000
