# Copy this file to envs/web.local.env and fill in real local values.
# envs/web.local.env is gitignored — never commit real values.
#
# These are the default values produced by `supabase start` for a freshly
# initialized local project (see `supabase status` after starting).

# Public — safe to expose to the browser (NEXT_PUBLIC_* is inlined at build time).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The publishable key (`sb_publishable_...`) — Supabase's replacement for
# the legacy `anon` key. Take it from `supabase status` -> PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key-from-supabase-status

# Server-only. The Supabase secret key (`sb_secret_...`) bypasses RLS and is
# used only by the server-only admin client (ADR 0037). Locally: `supabase
# status` -> SECRET_KEY; hosted: Supabase Dashboard -> API Keys. NEVER prefix
# it with NEXT_PUBLIC_ — that would ship it to every browser.
SUPABASE_SECRET_KEY=replace-with-sb_secret-key

# Web Push (VAPID). Generate a key pair once per environment with:
#   pnpm dlx web-push generate-vapid-keys --json
# The public key is safe in browser code. The private key is server-only.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
WEB_PUSH_VAPID_PRIVATE_KEY=replace-with-vapid-private-key
WEB_PUSH_VAPID_SUBJECT=mailto:you@example.com

# Error monitoring (Sentry, EU region, errors only — ADR 0041). All four are
# optional: with no DSN Sentry is simply off, which is the normal state for
# local work. Real values live in Vercel's environment variables.
# The DSN of an EU-region project has a host like *.ingest.de.sentry.io.
NEXT_PUBLIC_SENTRY_DSN=https://replace-with-key@o0.ingest.de.sentry.io/0
# Build-time only: uploads source maps, so stack traces are readable.
# Create an ORGANISATION token (Settings -> Developer Settings ->
# Organization Tokens), not a personal one: it carries the org:ci scope
# that source-map upload needs, and it is shown only once. Never
# NEXT_PUBLIC_*.
SENTRY_AUTH_TOKEN=replace-with-sentry-auth-token
SENTRY_ORG=replace-with-sentry-org-slug
SENTRY_PROJECT=replace-with-sentry-project-slug

# Next.js dev server port (used by `pnpm dev`).
PORT=3000

# Development only — never set in production (Vercel). true disables the
# "phone only" shield (ADR 0016, which replaced ADR 0015) so the app opens on
# desktop/tablets too.
# Unset or false — the default — keeps the shield active.
DEV_MODE=false

# Development only. Your machine's LAN IP(s), so the Next.js dev server
# accepts requests opened from a phone on the same Wi-Fi (e.g. to test on
# a real iPhone). Unset — the default — adds no extra allowed origin.
# Comma-separated when you move between networks (e.g. home Wi-Fi and a
# mobile hotspot) — whitespace around each entry is trimmed, empty
# entries are dropped. Find your address with `ipconfig getifaddr en0`
# (macOS Wi-Fi) or `hostname -I` (Linux); it changes whenever you change
# networks.
DEV_ALLOWED_ORIGIN=192.168.1.x,192.168.2.x

# Optional. Absolute base URL for metadata that must be fully qualified
# (robots.txt's Sitemap: line, sitemap.xml, metadataBase — ADR 0032).
# Leave unset for local development and most deployments — on Vercel,
# VERCEL_PROJECT_PRODUCTION_URL (a platform-injected variable, not set
# here) is used as a fallback once the project is linked. Set this only
# if you need to override that, e.g. a custom domain Vercel doesn't know
# about yet. No default value — the production domain has not been
# confirmed, so nothing is hardcoded.
SITE_URL=https://example.com

